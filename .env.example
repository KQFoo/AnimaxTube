# YouTube Data API v3 Key (required for discover & sync scripts)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Server settings
PORT=3000
DB_PATH=./data/animaxtube.db

# Public site origin used for canonical/OG URLs (defaults to the request origin)
PUBLIC_ORIGIN=https://animaxtube.example

# Railway / Docker production options
# RAILWAY_RUN_UID=0
# ENABLE_AUTO_SYNC=true
# LIVE_SYNC_INTERVAL_MIN=30
# INCREMENTAL_SYNC_INTERVAL_HOURS=4
# CHANNEL_SYNC_INTERVAL_HOURS=24
# CHANNEL_DISCOVERY_INTERVAL_HOURS=168
# ADMIN_TOKEN=replace_with_at_least_16_random_chars
# SEED_DB_URL=https://example.com/animaxtube.db.gz

# Optional AniList GraphQL endpoint for cross-channel series grouping & posters
ANILIST_API_URL=https://graphql.anilist.co
