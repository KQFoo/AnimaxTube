{
  "name": "animaxtube",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YouTube-style player & directory for all free English- and Chinese-subtitled anime series channels, grouped by series name.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node src/server.ts",
    "db:compact": "node src/db/compact.ts",
    "discover": "tsx src/discovery/discover-channels.ts",
    "channel:add": "node src/discovery/add-channel.ts",
    "sync": "tsx src/ingestion/sync-channels.ts",
    "sync:incremental": "node src/ingestion/sync-channels.ts --incremental",
    "sync:new": "node src/ingestion/sync-channels.ts --only-unsynced",
    "sync:songs": "tsx src/ingestion/sync-songs.ts",
    "enrich": "tsx src/ingestion/anilist-enrich.ts",
    "enrich:videos": "tsx src/ingestion/enrich-videos.ts",
    "enrich:comments": "tsx src/ingestion/enrich-comments.ts",
    "track:live": "tsx src/tracking/live-and-unlocks.ts",
    "export:md": "tsx src/export/generate-markdown.ts",
    "pipeline": "npm run discover && npm run sync && npm run enrich:videos && npm run track:live && npm run export:md",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "dotenv": "^16.5.0",
    "hono": "^4.7.10"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
